# Copy these into Railway: service -> Variables (the Raw Editor takes them in one paste). Never commit real values.
# docs/DEPLOY.md says what each one does.

# Needed
SECRET_KEY=change-me-to-a-long-random-string
COMMITTEE_CODE=
TEACHER_CODE=
STUDENT_CODE=

# Optional
# HEADS_CODE: heads of department; without it there is no heads' sign-in
HEADS_CODE=
SCHOOL_NAME=
# TELEGRAM_BOT_TOKEN: the school's Telegram bot for relief, on one service only (docs/DEPLOY.md, section 6); without it there
# is no Telegram. The word practice in its place sends nothing
TELEGRAM_BOT_TOKEN=
