# Copy these into Railway: service -> Variables (the Raw Editor takes them in one paste). Never commit real values.
# docs/DEPLOY.md says what each one does.

# Needed
SECRET_KEY=change-me-to-a-long-random-string
COMMITTEE_CODE=
TEACHER_CODE=
STUDENT_CODE=

# Optional
SCHOOL_NAME=

# The AI timetabler. Leave AI_PROVIDER empty to run without AI (Generate without AI still works); mock = a scripted stand-in for testing.
AI_PROVIDER=anthropic
# Fill in: your API key from the AI provider (for Anthropic, console.anthropic.com -> API keys). Without it the AI chat stays off.
AI_API_KEY=
AI_MODEL=claude-opus-5-5
# AI_EFFORT=xhigh
# AI_BASE_URL=

# The solver
SOLVE_SECONDS=300
# SOLVE_MAX_SECONDS=28800
# SOLVE_WORKERS=8
# STAGED_FROM_CLASSES=30
